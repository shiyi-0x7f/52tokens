# 生产环境配置示例：复制为 .env.prod 后填写。键与 .env.dev.example 保持一致。

# ---- 运行环境 ----
APP_ENV=prod
LOG_LEVEL=INFO

# ---- 端口 ----
API_PORT=8100
WEB_PORT=4321
ADMIN_PORT=5174

# ---- 公开站地址（canonical / sitemap 用）----
SITE_URL=https://<your-domain>
# 只在部署于可信反代之后设置，例如 Cloudflare 的 cf-connecting-ip
TRUSTED_IP_HEADER=

# ---- 后端地址（Docker 内网服务名）----
API_INTERNAL_URL=http://api:8100

# ---- 数据库（宝塔 PostgreSQL，项目专属库和账号）----
DATABASE_URL=postgresql+asyncpg://tokens52:<password>@<host>:5432/tokens52

# ---- Redis（宝塔 Redis）----
REDIS_URL=redis://:<password>@<host>:6379/6
REDIS_KEY_PREFIX=52tokens:

# ---- 内部服务令牌 ----
INTERNAL_API_TOKEN=<long-random-string>

# ---- Cloudflare Turnstile ----
TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# ---- 统一身份：SCC ----
SCC_BASE_URL=https://<scc-domain>
SCC_APP_ID=<app-id>
SCC_APP_SECRET=<app-secret>
# SCC 微信扫码回调页所在的源（SCC 的 WX_OPEN_REDIRECT_URI 的源，公开站校验 postMessage 来源）
WECHAT_CALLBACK_ORIGIN=https://wxauth.11xy.cn

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=https://<your-domain>/auth/google/callback

# ---- 会话与管理员 ----
SESSION_TTL_DAYS=30
# 这些邮箱用 Google 登录后自动成为后台管理员（逗号分隔）
ADMIN_EMAILS=

# ---- LLM：硅基流动 ----
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=<api-key>
LLM_EXTRACT_MODEL=Qwen/Qwen3-30B-A3B
