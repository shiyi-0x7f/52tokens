# 生产环境配置示例：复制为 .env.prod 后填写。键与 .env.dev.example 保持一致。

# ---- 运行环境 ----
APP_ENV=prod
LOG_LEVEL=INFO

# ---- 镜像（阿里云 ACR；由本机 deploy/build-push.sh 推送）----
IMAGE_REGISTRY=crpi-bveintih61x5c20a.cn-hangzhou.personal.cr.aliyuncs.com/shiyi_acr
# 留空用 latest；要固定版本（便于回滚）就填 build-push.sh 打的提交短哈希
IMAGE_TAG=

# ---- 后台访问路径（不要用 /admin/，避免被扫描；只写在这里，仓库里不出现）----
# 生成：echo "/$(openssl rand -hex 6)/"   宝塔 Nginx 反代规则里的路径要和这里一致
ADMIN_BASE_PATH=/<random>/

# ---- 端口（容器映射到宿主机 127.0.0.1 的端口，宝塔 Nginx 反代到这里；与 deploy/nginx-52tokens.conf 一致）----
API_PORT=8100
WEB_PORT=4321
ADMIN_PORT=5174

# ---- 公开站地址（canonical / sitemap / 分享图用；构建公开站镜像时写进产物，改了要重新 build-push）----
SITE_URL=https://52tokens.cc
# 只在部署于可信反代之后设置：宝塔 Nginx 会带 X-Real-IP；套了 Cloudflare 时改为 cf-connecting-ip
TRUSTED_IP_HEADER=x-real-ip
RATE_LIMIT_PER_MINUTE=120

# ---- 后端地址（api / web 用宿主机网络，走本机；compose.yaml 里会按 API_PORT 覆盖）----
API_INTERNAL_URL=http://127.0.0.1:8100

# ---- 数据库（宝塔 PostgreSQL，项目专属库和账号；容器用宿主机网络，直接连 127.0.0.1）----
DATABASE_URL=postgresql+asyncpg://tokens52:<password>@127.0.0.1:5432/tokens52

# ---- Redis（宝塔 Redis；用独立 db 编号 + key 前缀；没设密码时写成 redis://127.0.0.1:6379/6）----
REDIS_URL=redis://:<password>@127.0.0.1:6379/6
REDIS_KEY_PREFIX=52tokens:

# ---- 内部服务令牌 ----
INTERNAL_API_TOKEN=<long-random-string>

# ---- Cloudflare Turnstile ----
TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# ---- 统一身份：SCC ----
SCC_BASE_URL=https://<scc-domain>
SCC_APP_ID=<app-id>
SCC_APP_SECRET=<app-secret>
# SCC 微信扫码回调页所在的源（SCC 的 WX_OPEN_REDIRECT_URI 的源，公开站校验 postMessage 来源）
WECHAT_CALLBACK_ORIGIN=https://wxauth.11xy.cn

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=https://52tokens.cc/auth/google/callback

# ---- 会话与管理员 ----
SESSION_TTL_DAYS=30
# 这些邮箱用 Google 登录后自动成为后台管理员（逗号分隔）
ADMIN_EMAILS=

# ---- LLM：硅基流动 ----
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=<api-key>
LLM_EXTRACT_MODEL=Qwen/Qwen3-30B-A3B
