# 开发环境配置示例：复制为 .env.dev 后填写。只放键名和占位，真实值不入库。

# ---- 运行环境 ----
APP_ENV=dev
LOG_LEVEL=DEBUG

# ---- 端口（start-dev.sh 被占用时自动 +1 并回写）----
API_PORT=8100
WEB_PORT=4321
ADMIN_PORT=5174

# ---- 公开站地址（canonical / sitemap 用）----
SITE_URL=http://127.0.0.1:4321
# 只在部署于可信反代之后设置，例如 Cloudflare 的 cf-connecting-ip
TRUSTED_IP_HEADER=
# 公开站每个 IP 每分钟的请求上限
RATE_LIMIT_PER_MINUTE=120

# ---- 后端地址（公开站服务端、后台 dev 代理用）----
API_INTERNAL_URL=http://127.0.0.1:8100

# ---- 数据库：复用本机 dev-postgres，项目专属库和账号 ----
DATABASE_URL=postgresql+asyncpg://tokens52:change-me@127.0.0.1:5432/tokens52

# ---- Redis：复用本机 dev-redis，独立 db 编号 + key 前缀 ----
REDIS_URL=redis://127.0.0.1:6379/6
REDIS_KEY_PREFIX=52tokens:

# ---- 内部服务令牌：公开站服务端调用后端公开数据接口时携带 ----
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# ---- Cloudflare Turnstile（下面是 Cloudflare 官方测试 key，始终通过）----
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- 统一身份：SCC ----
SCC_BASE_URL=http://127.0.0.1:8001
SCC_APP_ID=
SCC_APP_SECRET=
# SCC 微信扫码回调页所在的源（SCC 的 WX_OPEN_REDIRECT_URI 的源，公开站校验 postMessage 来源）
WECHAT_CALLBACK_ORIGIN=https://wxauth.11xy.cn

# ---- Google OAuth（Google Cloud Console 的 Web 应用客户端）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4321/auth/google/callback

# ---- 会话与管理员 ----
SESSION_TTL_DAYS=30
# 这些邮箱用 Google 登录后自动成为后台管理员（逗号分隔）
ADMIN_EMAILS=

# ---- LLM：硅基流动（OpenAI 兼容）----
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
LLM_EXTRACT_MODEL=Qwen/Qwen3-30B-A3B
