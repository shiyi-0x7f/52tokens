# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 前端 / 配置文件用 2 空格
[*.{js,jsx,ts,tsx,mjs,cjs,astro,json,css,html,yml,yaml,toml}]
indent_size = 2

[*.py]
indent_size = 4

# Markdown 行尾空格有语义，保留
[*.md]
trim_trailing_whitespace = false
