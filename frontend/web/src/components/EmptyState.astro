---
interface Props {
  title: string;
  hint?: string;
}
const { title, hint } = Astro.props;
---

<div class="rounded-(--radius-card) border border-dashed border-line bg-card px-6 py-10 text-center">
  <p class="font-bold text-ink">{title}</p>
  {hint && <p class="mt-2 text-sm text-mute">{hint}</p>}
  <slot />
</div>
