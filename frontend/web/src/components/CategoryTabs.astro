---
/**
 * 大类切换栏（卡网比价、订阅地区价共用）：横向滚动，两端渐隐提示可滑动。
 *
 * 所有大类的内容都由服务端渲染进 HTML（data-category-panel，非当前的先 hidden），点击时在页面内
 * 直接切换并 replaceState 更新网址，不发请求、不走整页导航，切换即时。高亮底块是一个独立元素，
 * 用 CSS 过渡滑到选中项。没有 JS 时链接照常跳转（?参数，服务端渲染当前大类）。
 *
 * 用法：页面用 [data-category-root] 包住本组件和各个 [data-category-panel={key}]。
 */
import { brandOf } from "../lib/brand";
import BrandMark from "./BrandMark.astro";

export interface CategoryTab {
  key: string;
  label: string;
  href: string;
  count: number;
  /** 筛选后没有匹配项：变淡显示 */
  empty?: boolean;
  /** 品牌查找键（平台 slug、应用 slug 等），查不到时用 label 取色 */
  brandKeys?: string[];
}

interface Props {
  tabs: CategoryTab[];
  activeKey: string | null;
  label: string;
}
const { tabs, activeKey, label } = Astro.props;
---

<nav aria-label={label} class="relative -mx-4 mb-4 sm:mx-0">
  <ul class="category-tabs scrollbar-thin relative flex snap-x gap-1.5 overflow-x-auto px-4 py-1.5 sm:px-1">
    <li aria-hidden="true" class="category-indicator"></li>
    {tabs.map((t) => {
      const brand = brandOf(t.label, ...(t.brandKeys ?? []));
      return (
        <li class="relative shrink-0 snap-start">
          <a
            href={t.href}
            data-category-tab={t.key}
            aria-current={t.key === activeKey ? "page" : undefined}
            data-empty={t.empty ? "" : undefined}
            class="category-tab press group inline-flex min-h-11 items-center gap-2 rounded-full py-1.5 pr-4 pl-1.5 text-sm whitespace-nowrap no-underline"
            style={`--brand:${brand.color};--on-brand:${brand.dark ? "#18181b" : "#ffffff"}`}
          >
            <BrandMark name={t.label} keys={t.brandKeys ?? []} size="sm" class="rounded-full" />
            <span>{t.label}</span>
            <span class="category-count rounded-full px-1.5 font-mono text-[11px] leading-5">
              {t.count}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style is:global>
  /* 两端渐隐：内容多于一屏时提示可以左右滑动；内边距保证首尾项本身不被遮住 */
  .category-tabs {
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 16px,
      #000 calc(100% - 16px),
      transparent
    );
  }
  .category-tab {
    position: relative;
    z-index: 1;
    color: var(--color-sub);
  }
  .category-tab:hover {
    background: var(--color-card);
    color: var(--color-ink);
  }
  .category-count {
    background: var(--color-chip);
    color: var(--color-mute);
  }
  .category-tab[aria-current="page"] {
    color: var(--on-brand);
    font-weight: 700;
    /* 没有 JS（底块不显示）时，选中项自己带品牌色底 */
    background: var(--brand);
  }
  .category-tab[aria-current="page"] .category-count {
    background: rgb(255 255 255 / 0.2);
    color: inherit;
  }

  /* 滑动底块：JS 就绪后显示，选中项自身的底色让给它 */
  .category-indicator {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 9999px;
    opacity: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.18), transparent 60%), var(--brand, transparent);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 6px 16px -6px color-mix(in srgb, var(--brand, transparent) 70%, transparent);
  }
  .category-tabs[data-ready] .category-indicator {
    opacity: 1;
  }
  .category-tabs[data-ready] .category-tab[aria-current="page"] {
    background: transparent;
  }
  .category-tabs[data-animate] .category-indicator {
    transition:
      transform var(--motion-base) var(--ease-out),
      width var(--motion-base) var(--ease-out),
      background-color var(--motion-base) ease;
  }

  /* 搜索时结果跨大类，不突出某一个大类；没有匹配的大类变淡 */
  [data-category-root][data-searching] .category-indicator {
    opacity: 0;
  }
  [data-category-root][data-searching] .category-tab[aria-current="page"] {
    color: var(--color-sub);
    font-weight: inherit;
    background: transparent;
  }
  .category-tab[data-empty] {
    opacity: 0.45;
  }

  /* 切换后内容快速淡入（从 hidden 变为显示时动画会重新播放） */
  [data-category-panel]:not([hidden]) {
    animation: rise-in var(--motion-fast) var(--ease-out) both;
  }
</style>

<script>
  function place(list: HTMLElement, tab: HTMLElement): void {
    const indicator = list.querySelector<HTMLElement>(".category-indicator");
    const item = tab.parentElement;
    if (!indicator || !item) return;
    indicator.style.transform = `translate(${item.offsetLeft}px, ${item.offsetTop}px)`;
    indicator.style.width = `${tab.offsetWidth}px`;
    indicator.style.height = `${tab.offsetHeight}px`;
    indicator.style.setProperty("--brand", tab.style.getPropertyValue("--brand"));
  }

  function center(list: HTMLElement, tab: HTMLElement, smooth: boolean): void {
    const item = tab.parentElement ?? tab;
    const left = item.offsetLeft - (list.clientWidth - item.offsetWidth) / 2;
    list.scrollTo({ left: Math.max(0, left), behavior: smooth ? "smooth" : "auto" });
  }

  function setup(root: HTMLElement): void {
    const list = root.querySelector<HTMLElement>(".category-tabs");
    if (!list || list.dataset["bound"]) return;
    list.dataset["bound"] = "1";
    const tabs = [...list.querySelectorAll<HTMLElement>("[data-category-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-category-panel]")];

    const current = tabs.find((t) => t.getAttribute("aria-current") === "page") ?? tabs[0];
    if (current) {
      place(list, current);
      center(list, current, false);
    }
    list.dataset["ready"] = "";
    // 首次定位不要动画，下一帧再打开过渡
    requestAnimationFrame(() => {
      list.dataset["animate"] = "";
    });

    list.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLElement>("[data-category-tab]");
      if (!tab || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      const key = tab.dataset["categoryTab"];
      const panel = panels.find((p) => p.dataset["categoryPanel"] === key);
      if (!panel) return; // 没有对应内容时交给正常跳转
      event.preventDefault();
      for (const t of tabs) {
        if (t === tab) t.setAttribute("aria-current", "page");
        else t.removeAttribute("aria-current");
      }
      for (const p of panels) p.hidden = p !== panel;
      place(list, tab);
      center(list, tab, true);
      // 保留 Astro 路由写在 history.state 里的信息，只换网址
      history.replaceState(history.state, "", tab.getAttribute("href") ?? location.href);
    });

    // 字体加载、窗口变化、筛选后数字变化都会改变按钮宽度，重新对齐底块
    const observer = new ResizeObserver(() => {
      const active = tabs.find((t) => t.getAttribute("aria-current") === "page");
      if (active) place(list, active);
    });
    observer.observe(list);
    for (const t of tabs) observer.observe(t);
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-category-root]").forEach(setup);
  });
</script>
