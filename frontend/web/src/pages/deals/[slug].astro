---
import JsonLd from "../../components/JsonLd.astro";
import PromotedLabel from "../../components/PromotedLabel.astro";
import RelatedDeals from "../../components/RelatedDeals.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { internalGet, isNotFound } from "../../lib/api";
import { formatDate, formatRelative } from "../../lib/format";
import { CYCLE_LABELS, DEAL_TYPE_LABELS } from "../../lib/labels";
import { loadOr } from "../../lib/load";
import { dealGoUrl } from "../../lib/outbound";
import type { Deal } from "../../lib/types";

const slug = Astro.params.slug ?? "";
let deal: Deal;
try {
  deal = await internalGet<Deal>(`/deals/${encodeURIComponent(slug)}`);
} catch (err) {
  if (isNotFound(err)) return Astro.rewrite("/404");
  throw err;
}

const typeLabel = DEAL_TYPE_LABELS[deal.deal_type];
const title = `${deal.platform.name}${typeLabel}：${deal.title}`;

// 已结束的活动页面保留（保住搜索权重），引导到同平台进行中的活动；再补其他平台的同类活动
const [[samePlatform], [sameType]] = await Promise.all([
  loadOr<Deal[]>([], () =>
    internalGet<Deal[]>("/deals", { platform: deal.platform.slug, limit: 6 }),
  ),
  loadOr<Deal[]>([], () => internalGet<Deal[]>("/deals", { deal_type: deal.deal_type, limit: 12 })),
]);
const related = samePlatform.filter((d) => d.slug !== deal.slug).slice(0, 5);
const similar = sameType.filter((d) => d.platform.slug !== deal.platform.slug).slice(0, 5);
const hasQuote = deal.source_quote !== "";
---

<BaseLayout
  title={`${title} · 52tokens`}
  description={`${deal.platform.name} ${typeLabel}：${deal.reward_text}。${CYCLE_LABELS[deal.cycle]}，${formatRelative(deal.confirmed_at)}核实，附官方出处。`}
>
  <JsonLd
    slot="head"
    data={{
      "@context": "https://schema.org",
      "@type": "Offer",
      name: title,
      description: deal.reward_text,
      url: new URL(`/deals/${deal.slug}`, Astro.site).href,
      seller: { "@type": "Organization", name: deal.platform.name },
      ...(deal.starts_at ? { validFrom: deal.starts_at } : {}),
      ...(deal.ends_at ? { validThrough: deal.ends_at } : {}),
      availability: deal.is_expired
        ? "https://schema.org/Discontinued"
        : "https://schema.org/InStock",
    }}
  />

  <nav class="mb-3 text-xs text-mute" aria-label="面包屑">
    <a href="/deals" class="no-underline">
      签到 & 活动
    </a>{" "}
    /
    <a href={`/platforms/${deal.platform.slug}`} class="no-underline">
      {deal.platform.name}
    </a>
  </nav>

  {deal.is_expired && (
    <div class="mb-4 rounded-(--radius-card) border border-line bg-card px-4 py-3 text-sm text-sub">
      这个活动已经结束。下面列出了 {deal.platform.name} 进行中的其他活动。
    </div>
  )}

  <article class="rounded-(--radius-card) bg-card p-6">
    <p class="text-sm text-mute">
      {deal.platform.name} · {typeLabel} · {CYCLE_LABELS[deal.cycle]}
    </p>
    <h1 class="mt-1 text-2xl font-black">{deal.title}</h1>
    <p class="mt-3 font-mono text-3xl font-bold text-hot">{deal.reward_text}</p>

    <dl class="mt-5 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
      {deal.requirements.length > 0 && (
        <>
          <dt class="text-mute">参与门槛</dt>
          <dd>{deal.requirements.join("、")}</dd>
        </>
      )}
      {deal.ends_at && (
        <>
          <dt class="text-mute">截止时间</dt>
          <dd>{formatDate(deal.ends_at)}</dd>
        </>
      )}
      {deal.est_value_cny && (
        <>
          <dt class="text-mute">估值</dt>
          <dd>约 ¥{Number(deal.est_value_cny).toFixed(0)}（按官方价折算）</dd>
        </>
      )}
      <dt class="text-mute">最近核实</dt>
      <dd>
        {formatRelative(deal.confirmed_at)} ·
        <a href={deal.source_url} rel="nofollow noopener" target="_blank">
          官方出处
        </a>
      </dd>
    </dl>

    {deal.description && (
      <p class="mt-5 text-sm leading-relaxed whitespace-pre-line text-sub">{deal.description}</p>
    )}

    {!deal.is_expired && (
      <p class="mt-6">
        <a
          href={dealGoUrl(deal.slug)}
          rel={deal.is_promoted ? "sponsored nofollow noopener" : "nofollow noopener"}
          target="_blank"
          class="inline-flex min-h-11 items-center rounded-[10px] bg-hot px-5 font-bold text-white no-underline"
        >
          去 {deal.platform.name} 参与
        </a>
        {deal.is_promoted && <PromotedLabel />}
      </p>
    )}
  </article>

  <section class="mt-6 rounded-(--radius-card) bg-card p-6" aria-labelledby="howto-title">
    <h2 id="howto-title" class="font-black">
      怎么参与
    </h2>
    {deal.steps.length > 0 ? (
      <ol class="mt-3 space-y-2 text-sm">
        {deal.steps.map((step, i) => (
          <li class="flex gap-3">
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-hot font-mono text-xs font-bold text-white">
              {i + 1}
            </span>
            <span class="pt-0.5 leading-relaxed">{step}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="mt-3 text-sm leading-relaxed text-sub">
        打开 {deal.platform.name} 的官方页面，按页面说明参与。
        {hasQuote && "下方附有官网原文，可以直接定位到活动所在的位置。"}
      </p>
    )}
    {deal.in_app_only && (
      <p class="mt-3 text-sm text-sub">
        这个活动需要在 {deal.platform.name} 客户端或 App 内完成，网页上可能看不到入口。
      </p>
    )}

    {hasQuote && (
      <figure class="mt-5">
        <figcaption class="mb-2 text-xs text-mute">官网原文</figcaption>
        <blockquote class="border-l-4 border-hot bg-bg px-4 py-3 text-sm leading-relaxed">
          {deal.source_quote}
        </blockquote>
      </figure>
    )}
    <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <a href={deal.source_locate_url} rel="nofollow noopener" target="_blank" class="text-hot">
        {hasQuote ? "在官网中定位这段话 ↗" : "打开官方页面 ↗"}
      </a>
      {hasQuote && (
        <span class="text-xs text-mute">Chrome、Edge、Safari 打开后会自动滚动到这段话并高亮</span>
      )}
    </p>
  </section>

  <RelatedDeals
    title={`${deal.platform.name} 的其他活动`}
    deals={related}
    moreHref={`/platforms/${deal.platform.slug}`}
  />
  <RelatedDeals
    title={`其他平台的${typeLabel}活动`}
    deals={similar}
    moreHref={`/deals?type=${deal.deal_type}`}
    showPlatform
  />
</BaseLayout>
