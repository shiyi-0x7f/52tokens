---
/**
 * 两个模型的 API 价格对比：/models/{a}-vs-{b}。
 *
 * 后台精选名单里的组合才让搜索引擎收录（进 sitemap、带 canonical），反过来的网址 301 到收录顺序；
 * 其他组合页面照样能看，但 noindex，避免产生无数薄页面。
 * 路由优先级：部分动态的 [a]-vs-[b] 先于纯动态的 [slug] 匹配（Astro routeComparator）。
 */
import CompareTable from "../../components/CompareTable.astro";
import JsonLd from "../../components/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { internalGet, isNotFound } from "../../lib/api";
import { buildCompareRows } from "../../lib/compare";
import { formatRelative } from "../../lib/format";
import { loadOr } from "../../lib/load";
import { compareUrl } from "../../lib/models-url";
import type { ModelComparison, ModelDetail } from "../../lib/types";
import { buildVsSummary, vsPath } from "../../lib/vs";

const RELATED_LIMIT = 8;

const slugA = Astro.params.a ?? "";
const slugB = Astro.params.b ?? "";
if (slugA === slugB) return Astro.rewrite("/404");

async function getOrNull<T>(path: string): Promise<T | null> {
  try {
    return await internalGet<T>(path);
  } catch (err) {
    if (isNotFound(err)) return null;
    throw err;
  }
}

const enc = encodeURIComponent;
const [modelA, modelB, featured] = await Promise.all([
  getOrNull<ModelDetail>(`/models/${enc(slugA)}`),
  getOrNull<ModelDetail>(`/models/${enc(slugB)}`),
  getOrNull<ModelComparison>(`/model-comparisons/${enc(slugA)}/${enc(slugB)}`),
]);
if (!modelA || !modelB) return Astro.rewrite("/404");

// 收录的是反过来的顺序：跳到规范网址，避免两个网址内容重复
if (featured && featured.model_a.slug !== slugA) {
  return Astro.redirect(vsPath(featured.model_a.slug, featured.model_b.slug), 301);
}

const [relatedA, relatedB] = await Promise.all([
  loadOr<ModelComparison[]>([], () => internalGet("/model-comparisons", { model: slugA })),
  loadOr<ModelComparison[]>([], () => internalGet("/model-comparisons", { model: slugB })),
]);
const seen = new Set([vsPath(slugA, slugB)]);
const related = [...relatedA[0], ...relatedB[0]]
  .map((c) => ({ c, href: vsPath(c.model_a.slug, c.model_b.slug) }))
  .filter(({ href }) => !seen.has(href) && seen.add(href))
  .slice(0, RELATED_LIMIT);

const models = [modelA, modelB];
const rows = buildCompareRows(models);
const { highlights, faq } = buildVsSummary(modelA, modelB);
const title = `${modelA.name} vs ${modelB.name}`;
const latest = models
  .flatMap((m) => m.prices.map((p) => p.confirmed_at))
  .sort()
  .at(-1);
---

<BaseLayout
  title={`${title} API 价格对比 · 52tokens`}
  description={`${highlights.slice(0, 2).join("")} 对比两者各平台输入输出价格、上下文与免费渠道。`}
  noindex={!featured}
>
  <JsonLd
    slot="head"
    data={{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "模型价格",
          item: new URL("/models", Astro.site).href,
        },
        { "@type": "ListItem", position: 2, name: title },
      ],
    }}
  />
  <JsonLd
    slot="head"
    data={{
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }}
  />

  <nav class="mb-3 text-xs text-mute" aria-label="面包屑">
    <a href="/models" class="no-underline">
      模型价格
    </a>{" "}
    / {title}
  </nav>

  <header class="mb-5">
    <h1 class="text-2xl font-black">{title} API 价格对比</h1>
    <ul class="mt-2 space-y-1 text-sm text-sub">
      {highlights.map((h) => (
        <li>{h}</li>
      ))}
    </ul>
    {featured?.intro && (
      <p class="mt-3 text-sm leading-relaxed whitespace-pre-line">{featured.intro}</p>
    )}
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {models.map((m) => (
        <a href={`/models/${m.slug}`} class="text-hot">
          {m.name} 全部价格 →
        </a>
      ))}
      <a href={compareUrl([slugA, slugB])} rel="nofollow" class="text-mute">
        加入更多模型对比
      </a>
    </p>
  </header>

  <CompareTable models={models} rows={rows} />
  <p class="mt-3 text-xs text-mute">
    绿色为该项最优值。价格只在同币种之间比较，不做汇率换算；免费渠道通常有请求频率限制。
    {latest && `价格最近核实于 ${formatRelative(latest)}。`}
  </p>

  <section aria-labelledby="faq-title" class="mt-8">
    <h2 id="faq-title" class="mb-3 font-black">
      常见问题
    </h2>
    <dl class="rounded-(--radius-card) bg-card">
      {faq.map((f) => (
        <div class="border-b border-line px-4 py-3 last:border-b-0">
          <dt class="text-sm font-bold">{f.q}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-sub">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="free-title" class="mt-8">
    <h2 id="free-title" class="mb-3 font-black">
      免费额度
    </h2>
    <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {models.map((m) => (
        <a href={`/free/${m.slug}`} class="text-hot">
          {m.name} 免费渠道与免费额度 →
        </a>
      ))}
    </p>
  </section>

  {related.length > 0 && (
    <section aria-labelledby="related-title" class="mt-8">
      <h2 id="related-title" class="mb-3 font-black">
        相关对比
      </h2>
      <ul class="flex flex-wrap gap-2">
        {related.map(({ c, href }) => (
          <li>
            <a
              href={href}
              class="press inline-flex min-h-10 items-center rounded-full border border-line bg-card px-4 text-sm no-underline hover:border-ink"
            >
              {c.model_a.name} vs {c.model_b.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
