---
import BrandMark from "../../components/BrandMark.astro";
import JsonLd from "../../components/JsonLd.astro";
import ShopDisclaimer from "../../components/ShopDisclaimer.astro";
import TypeChip from "../../components/TypeChip.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { internalGet, isNotFound } from "../../lib/api";
import { brandOf } from "../../lib/brand";
import { formatPrice, formatRelative } from "../../lib/format";
import { offerGoUrl } from "../../lib/outbound";
import { shopTypeTone } from "../../lib/tones";
import type { ShopProductDetail } from "../../lib/types";

const slug = Astro.params.slug ?? "";
let product: ShopProductDetail;
try {
  product = await internalGet<ShopProductDetail>(`/shop-products/${encodeURIComponent(slug)}`);
} catch (err) {
  if (isNotFound(err)) return Astro.rewrite("/404");
  throw err;
}

const fresh = product.offers.filter((o) => o.is_fresh);
const stale = product.offers.filter((o) => !o.is_fresh);
// 后端已排好序：第一条新鲜、有货、没被标记的就是有货最低价
const best = fresh.find((o) => o.in_stock && o.flags.length === 0);
const lowest = product.min_price ? formatPrice(product.min_price, "CNY") : null;
const description = lowest
  ? `${product.name} 卡网有货最低价 ${lowest}，${product.in_stock_shops} 家店铺有货。汇总各店铺公开报价，定时更新。`
  : `${product.name} 各卡网店铺的公开报价汇总，定时更新。`;
---

<BaseLayout title={`${product.name} 价格比较：卡网有货最低价 · 52tokens`} description={description}>
  <JsonLd
    slot="head"
    data={{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "卡网比价",
          item: new URL("/products", Astro.site).href,
        },
        { "@type": "ListItem", position: 2, name: product.name },
      ],
    }}
  />

  <nav class="mb-3 text-xs text-mute" aria-label="面包屑">
    <a href="/products" class="no-underline">
      卡网比价
    </a>{" "}
    / {product.platform}
  </nav>

  <header class="mb-4 overflow-hidden rounded-(--radius-card) bg-card">
    <div class="h-1.5" style={`background:${brandOf(product.platform).color}`}></div>
    <div class="p-6">
      <div class="flex items-center gap-3">
        <BrandMark name={product.platform} size="lg" />
        <div class="min-w-0">
          <p class="flex items-center gap-2 text-sm text-mute">
            {product.platform}
            <TypeChip label={product.product_type} tone={shopTypeTone(product.product_type)} />
          </p>
          <h1 class="mt-1 text-2xl font-black">{product.name}</h1>
        </div>
      </div>
      {product.spec && <p class="mt-2 text-sm text-sub">{product.spec}</p>}
      <p class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1">
        {lowest ? (
          <>
            <span class="font-mono text-3xl font-bold text-hot">{lowest}</span>
            <span class="text-sm text-sub">有货最低价 · {product.in_stock_shops} 家有货</span>
            <span class="w-full text-xs text-mute">
              拼车、价格待核实和两天内没更新的报价不计入最低价
            </span>
          </>
        ) : (
          <span class="text-sm text-sub">暂无有货报价</span>
        )}
      </p>
      {product.summary && <p class="mt-4 text-sm leading-relaxed text-sub">{product.summary}</p>}
    </div>
  </header>

  <ShopDisclaimer />

  <section class="mt-6" aria-labelledby="offers-title">
    <h2 id="offers-title" class="mb-3 font-black">
      店铺报价
      <span class="ml-2 font-mono text-sm font-normal text-mute">{fresh.length}</span>
    </h2>
    {fresh.length === 0 ? (
      <p class="rounded-(--radius-card) bg-card px-4 py-3 text-sm text-sub">
        近两天没有采集到报价。
      </p>
    ) : (
      <div class="overflow-x-auto rounded-(--radius-card) bg-card">
        <table class="w-full min-w-[640px] text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs text-mute">
              <th class="px-4 py-2.5 font-medium">店铺标题</th>
              <th class="px-4 py-2.5 text-right font-medium">价格</th>
              <th class="px-4 py-2.5 text-right font-medium">库存</th>
              <th class="px-4 py-2.5 font-medium">店铺</th>
            </tr>
          </thead>
          <tbody>
            {fresh.map((o) => (
              <tr
                class:list={[
                  "border-b border-line last:border-b-0",
                  o === best && "bg-tone-green-bg/60",
                  !o.in_stock && "opacity-60",
                ]}
              >
                <td class="px-4 py-3">
                  <span class="block">
                    {o === best && (
                      <span class="mr-1.5 rounded bg-tone-green px-1.5 text-[11px] font-bold text-white">
                        最低价
                      </span>
                    )}
                    {o.flags.map((f) => (
                      <span
                        class="mr-1.5 rounded border border-ad-line bg-ad-bg px-1.5 text-[11px] text-ad-ink"
                        title="不计入有货最低价"
                      >
                        {f}
                      </span>
                    ))}
                    {o.title}
                  </span>
                  {o.tags.length > 0 && (
                    <span class="mt-1 block text-xs text-mute">{o.tags.join(" · ")}</span>
                  )}
                </td>
                <td
                  class:list={[
                    "px-4 py-3 text-right font-mono font-bold whitespace-nowrap",
                    o === best && "text-base text-tone-green",
                  ]}
                >
                  {formatPrice(o.price, "CNY")}
                </td>
                <td class="px-4 py-3 text-right text-xs whitespace-nowrap">
                  <span
                    class:list={[
                      "rounded-full px-2 py-0.5 font-bold",
                      o.in_stock ? "bg-tone-green-bg text-tone-green" : "bg-chip text-mute",
                    ]}
                  >
                    {o.in_stock ? (o.stock ?? "有货") : "无货"}
                  </span>
                </td>
                <td class="px-4 py-3 text-xs whitespace-nowrap">
                  <a
                    href={offerGoUrl(o.token)}
                    rel="nofollow noopener"
                    target="_blank"
                    class="text-sub"
                    data-leave="shop"
                    data-leave-host={o.shop}
                    data-leave-label={`第三方店铺 ${o.shop}`}
                    data-leave-title={`${o.title} · ${formatPrice(o.price, "CNY")}`}
                  >
                    {o.shop} ↗
                  </a>
                  <span class="block text-mute">{formatRelative(o.last_seen_at)}更新</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  {stale.length > 0 && (
    <section class="mt-6" aria-labelledby="stale-title">
      <h2 id="stale-title" class="mb-1 font-black text-sub">
        可能已失效
      </h2>
      <p class="mb-3 text-xs text-mute">
        这些报价超过两天没再采集到（店铺可能下架或无法访问），不计入最低价。
      </p>
      <ul class="rounded-(--radius-card) bg-card text-sm opacity-70">
        {stale.map((o) => (
          <li class="flex justify-between gap-3 border-b border-line px-4 py-2.5 last:border-b-0">
            <span class="min-w-0">{o.title}</span>
            <span class="font-mono whitespace-nowrap">{formatPrice(o.price, "CNY")}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
