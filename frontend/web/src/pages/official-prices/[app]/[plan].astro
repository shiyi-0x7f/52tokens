---
import JsonLd from "../../../components/JsonLd.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { internalGet, isNotFound } from "../../../lib/api";
import { formatDate, formatPrice, formatRelative } from "../../../lib/format";
import type { OfficialPlanDetail } from "../../../lib/types";

const { app = "", plan = "" } = Astro.params;
let detail: OfficialPlanDetail;
try {
  detail = await internalGet<OfficialPlanDetail>(
    `/official-plans/${encodeURIComponent(app)}/${encodeURIComponent(plan)}`,
  );
} catch (err) {
  if (isNotFound(err)) return Astro.rewrite("/404");
  throw err;
}

const cheapest = detail.cheapest;
const fxDate = detail.prices.find((p) => p.fx_date)?.fx_date ?? null;
const description = cheapest
  ? `${detail.plan_name} 在 ${detail.region_count} 个国家 / 地区的 App Store 价格对比：最便宜的是${cheapest.country_label}，约 ${formatPrice(cheapest.cny_price, "CNY")}${detail.us ? `，美区约 ${formatPrice(detail.us.cny_price, "CNY")}` : ""}。`
  : `${detail.plan_name} 各国 App Store 价格对比。`;
---

<BaseLayout
  title={`${detail.plan_name} 各国价格对比：哪个地区最便宜 · 52tokens`}
  description={description}
>
  <JsonLd
    slot="head"
    data={{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "官方订阅地区价",
          item: new URL("/official-prices", Astro.site).href,
        },
        { "@type": "ListItem", position: 2, name: detail.plan_name },
      ],
    }}
  />

  <nav class="mb-3 text-xs text-mute" aria-label="面包屑">
    <a href="/official-prices" class="no-underline">
      官方订阅地区价
    </a>{" "}
    / {detail.app_name}
  </nav>

  <header class="mb-5 rounded-(--radius-card) bg-card p-6">
    <p class="text-sm text-mute">
      {detail.provider} · {detail.app_name}
    </p>
    <h1 class="mt-1 text-2xl font-black">{detail.plan_name} 各国价格</h1>
    <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
      {cheapest && (
        <>
          <dt class="text-mute">最便宜</dt>
          <dd>
            {cheapest.country_label}
            <span class="ml-2 font-mono text-xl font-bold text-hot">
              {formatPrice(cheapest.cny_price, "CNY")}
            </span>
            <span class="ml-2 text-xs text-sub">
              {cheapest.price_text}
              {cheapest.vs_us_percent !== null && ` · 美区的 ${cheapest.vs_us_percent}%`}
            </span>
          </dd>
        </>
      )}
      {detail.us && (
        <>
          <dt class="text-mute">美区</dt>
          <dd>
            <span class="font-mono">{detail.us.price_text}</span>
            <span class="ml-2 text-xs text-sub">≈ {formatPrice(detail.us.cny_price, "CNY")}</span>
          </dd>
        </>
      )}
      {detail.fetched_at && (
        <>
          <dt class="text-mute">最近核实</dt>
          <dd>
            {formatRelative(detail.fetched_at)}
            {fxDate && <span class="ml-2 text-xs text-mute">汇率日期 {formatDate(fxDate)}</span>}
          </dd>
        </>
      )}
    </dl>
  </header>

  <div class="overflow-x-auto rounded-(--radius-card) bg-card">
    <table class="w-full min-w-[560px] text-sm">
      <thead>
        <tr class="border-b border-line text-left text-xs text-mute">
          <th class="px-4 py-2.5 font-medium">地区</th>
          <th class="px-4 py-2.5 text-right font-medium">当地价格</th>
          <th class="px-4 py-2.5 text-right font-medium">折合人民币</th>
          <th class="px-4 py-2.5 text-right font-medium">相对美区</th>
        </tr>
      </thead>
      <tbody>
        {detail.prices.map((p) => (
          <tr class="border-b border-line last:border-b-0">
            <td class="px-4 py-3">
              <a href={p.source_url} rel="nofollow noopener" target="_blank" class="no-underline">
                {p.country_label}
              </a>
            </td>
            <td class="px-4 py-3 text-right font-mono whitespace-nowrap">{p.price_text}</td>
            <td class="px-4 py-3 text-right font-mono font-bold whitespace-nowrap">
              {formatPrice(p.cny_price, "CNY")}
            </td>
            <td
              class:list={[
                "px-4 py-3 text-right font-mono whitespace-nowrap",
                p.vs_us_percent !== null && p.vs_us_percent < 100 ? "text-good" : "text-sub",
              ]}
            >
              {p.vs_us_percent === null ? "—" : `${p.vs_us_percent}%`}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {detail.missing_regions.length > 0 && (
    <p class="mt-3 text-xs text-mute">
      以下地区的 App Store 没有上架这个订阅：{detail.missing_regions.join("、")}。
    </p>
  )}
  <p class="mt-3 text-xs leading-relaxed text-mute">
    价格来自各国 App Store 公开页面，点地区名可查看原页面。订阅需要对应地区的 Apple ID
    和当地支付方式；App Store 价格可能含当地税费，与官网网页订阅价不同，汇率按核实当天折算。
  </p>
</BaseLayout>
