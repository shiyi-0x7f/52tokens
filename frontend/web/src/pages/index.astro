---
import DealRow from "../components/DealRow.astro";
import EmptyState from "../components/EmptyState.astro";
import JsonLd from "../components/JsonLd.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { internalGet } from "../lib/api";
import { formatPrice } from "../lib/format";
import { CATEGORY_LABELS, CATEGORY_ORDER, DEAL_TYPE_LABELS } from "../lib/labels";
import { loadOr } from "../lib/load";
import type { Currency, Deal, DealType, ModelSummary, Platform } from "../lib/types";

// 首页热榜只放前几条，完整列表在 /deals
const HOT_LIST_SIZE = 10;

const [[deals, dealsOk], [models], [platforms]] = await Promise.all([
  loadOr<Deal[]>([], () => internalGet<Deal[]>("/deals", { limit: HOT_LIST_SIZE })),
  loadOr<ModelSummary[]>([], () => internalGet<ModelSummary[]>("/models")),
  loadOr<Platform[]>([], () => internalGet<Platform[]>("/platforms")),
]);

// 币种之间不换算比较：有人民币价就按人民币排，否则按美元排
const cheapestCurrency: Currency = models.some((m) => m.min_output_price_cny !== null)
  ? "CNY"
  : "USD";
const priceOf = (m: ModelSummary) =>
  cheapestCurrency === "CNY" ? m.min_output_price_cny : m.min_output_price_usd;
const cheapest = models
  .filter((m) => priceOf(m) !== null)
  .sort((a, b) => Number(priceOf(a)) - Number(priceOf(b)))
  .slice(0, 5);
const freeModels = models.filter((m) => m.has_free).slice(0, 5);
const tabs: DealType[] = ["checkin_points", "signup_credit", "free_quota", "student"];
const platformCounts = CATEGORY_ORDER.map((c) => ({
  category: c,
  count: platforms.filter((p) => p.category === c).length,
})).filter((x) => x.count > 0);
---

<BaseLayout
  title="52tokens · AI 羊毛热榜：免费额度、签到积分与模型 API 价格"
  description="每天核对的 AI 羊毛热榜：大模型 API 免费额度、AI 工具签到积分、注册赠送与模型 API 价格，标注出处和最近确认时间。"
>
  <JsonLd
    slot="head"
    data={{
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "52tokens",
      url: Astro.site?.href,
    }}
  />

  <section class="rounded-(--radius-card) bg-hot px-6 pt-6 text-white">
    <h1 class="text-3xl font-black">AI 羊毛热榜</h1>
    <p class="mt-1 text-sm opacity-85">
      免费额度 · 签到积分 · 注册赠送 · 模型 API 价格，每条都标注出处与最近确认时间
    </p>
    <nav class="mt-4 flex flex-wrap gap-1" aria-label="分类">
      <a
        href="/"
        class="rounded-t-[10px] bg-bg px-4 py-2.5 text-[15px] font-bold text-hot no-underline"
      >
        总榜
      </a>
      {tabs.map((t) => (
        <a
          href={`/deals?type=${t}`}
          class="rounded-t-[10px] px-4 py-2.5 text-[15px] font-bold text-white/85 no-underline hover:text-white"
        >
          {DEAL_TYPE_LABELS[t]}
        </a>
      ))}
    </nav>
  </section>

  <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section aria-labelledby="hot-title">
      <h2 id="hot-title" class="sr-only">
        热榜
      </h2>
      {!dealsOk ? (
        <EmptyState title="热榜暂时加载失败" hint="请稍后刷新页面。" />
      ) : deals.length === 0 ? (
        <EmptyState
          title="活动正在核实中"
          hint="首批平台已收录，签到、免费额度和注册赠送活动会在官网核实后陆续上榜。"
        >
          <a href="/platforms" class="mt-4 inline-block text-sm font-bold text-hot">
            先看收录的平台 →
          </a>
        </EmptyState>
      ) : (
        <div class="rounded-(--radius-card) bg-card py-1">
          {deals.map((deal, i) => (
            <DealRow deal={deal} rank={deal.is_expired ? undefined : i + 1} />
          ))}
          <a
            href="/deals"
            class="block px-4 py-3 text-center text-sm font-bold text-hot no-underline hover:bg-hover"
          >
            查看全部活动 →
          </a>
        </div>
      )}
      <p class="mt-2 text-xs text-mute">
        当前按最近核实时间排序；积累真实点击数据后切换为热度排序。
      </p>
    </section>

    <aside class="flex flex-col gap-4">
      <section class="rounded-(--radius-card) bg-card p-4">
        <h2 class="mb-3 flex items-center font-black">
          输出价最低
          <a href="/models" class="ml-auto text-xs font-normal text-mute no-underline">
            全部 →
          </a>
        </h2>
        {cheapest.length === 0 ? (
          <p class="text-sm text-mute">模型价格核实中。</p>
        ) : (
          <ul class="text-sm">
            {cheapest.map((m) => (
              <li class="border-b border-line py-2 last:border-b-0">
                <a href={`/models/${m.slug}`} class="flex justify-between no-underline">
                  <span>{m.name}</span>
                  <span class="font-mono font-bold">
                    {formatPrice(priceOf(m), cheapestCurrency)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="mt-2 text-[11px] text-mute">
          单位：{cheapestCurrency === "CNY" ? "人民币" : "美元"} / 百万输出 tokens，付费价
        </p>
      </section>

      {freeModels.length > 0 && (
        <section class="rounded-(--radius-card) bg-card p-4">
          <h2 class="mb-3 flex items-center font-black">
            免费可用的模型
            <a href="/free" class="ml-auto text-xs font-normal text-mute no-underline">
              全部 →
            </a>
          </h2>
          <ul class="text-sm">
            {freeModels.map((m) => (
              <li class="border-b border-line py-2 last:border-b-0">
                <a href={`/models/${m.slug}`} class="flex justify-between no-underline">
                  <span>{m.name}</span>
                  <span class="font-bold text-good">免费</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="rounded-(--radius-card) bg-card p-4">
        <h2 class="mb-3 flex items-center font-black">
          收录平台
          <a href="/platforms" class="ml-auto text-xs font-normal text-mute no-underline">
            全部 →
          </a>
        </h2>
        <ul class="text-sm">
          {platformCounts.map((x) => (
            <li class="flex justify-between border-b border-line py-2 last:border-b-0">
              <span>{CATEGORY_LABELS[x.category]}</span>
              <span class="font-mono font-bold">{x.count}</span>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
